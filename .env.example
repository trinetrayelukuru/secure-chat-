# SecureChat environment template
#
# Copy this file to `.env` in the project root and replace the placeholder
# below with the key you generate.  Every server and client that talks to each
# other must use the SAME key value.
#
# Generate one key (run this once, then share it privately with your peers):
#   .\.venv\Scripts\python.exe -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# The value is a 44-character URL-safe base64 Fernet key.
# Do NOT put a real key in this file, do not paste it into chat/screenshots,
# and never commit `.env`.

SECURECHAT_KEY=replace-with-your-generated-fernet-key
